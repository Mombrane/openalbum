# 复制为仓库根目录 .env 或 /etc/photo-album/api.env — 禁止提交真实值。

# --- 应用 ---
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://YOUR_DOMAIN_HERE
CORS_ORIGIN=https://YOUR_DOMAIN_HERE

# --- 鉴权 ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_TTL=7d
# API Key 哈希用的可选 pepper
API_KEY_PEPPER=CHANGE_ME_PEPPER

# --- PostgreSQL（本机或 Compose 服务） ---
DATABASE_URL=postgres://photo:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/photo_album
# 若更愿意拆开写：
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=photo
# PGPASSWORD=CHANGE_ME_DB_PASSWORD
# PGDATABASE=photo_album

# --- S3 兼容对象存储（腾讯云 COS / AWS S3 / MinIO） ---
S3_ENDPOINT=https://cos.ap-singapore.myqcloud.com
S3_REGION=ap-singapore
S3_BUCKET=YOUR_BUCKET_NAME
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_FORCE_PATH_STYLE=false
# 缩略图可选的 CDN 或公开访问基址；留空表示不用
S3_PUBLIC_BASE_URL=

# --- 视觉（描述 / 标签） ---
VISION_PROVIDER=http
VISION_API_BASE_URL=https://YOUR_VISION_API_BASE
VISION_API_KEY=YOUR_VISION_API_KEY
VISION_MODEL=YOUR_VISION_MODEL

# --- 嵌入 ---
EMBED_PROVIDER=http
EMBED_API_BASE_URL=https://YOUR_EMBED_API_BASE
EMBED_API_KEY=YOUR_EMBED_API_KEY
EMBED_MODEL=YOUR_EMBED_MODEL
# 必须与 schema.sql 中的向量维度一致
EMBED_DIMENSIONS=1536

# --- Worker ---
PIPELINE_POLL_MS=2000
PIPELINE_CONCURRENCY=2
