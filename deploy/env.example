# 全部是占位。复制到仓库根目录的 .env 或机器上的 EnvironmentFile 后再填写。
# 不要把填好的文件提交进 git。

DATABASE_URL=postgres://openalbum:change-me@127.0.0.1:5432/openalbum
JWT_SECRET=change-me

S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

VISION_API_URL=https://example.com/vision
VISION_API_KEY=change-me
EMBED_API_URL=https://example.com/embed
EMBED_API_KEY=change-me

ALBUM_PASSPHRASE_PEPPER=change-me

PORT=3000
